{
  "name": "depo-dolu",
  "version": "0.1.0",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "cap:sync": "ng build && npx cap sync android",
    "android": "ng build && npx cap sync android && npx cap open android",
    "assets:native": "python tools/generate_native_assets.py && npx -y @capacitor/assets@4 generate --android --iconBackgroundColor #0e3b4a --iconBackgroundColorDark #0e3b4a --splashBackgroundColor #0e3b4a --splashBackgroundColorDark #0e3b4a"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@ionic/angular": "^8.8.19",
    "firebase": "^12.19.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.0",
    "@capacitor/cli": "^8.6.0",
    "typescript": "~5.7.2"
  },
  "overrides": {
    "schema-utils@^4.0.0": "4.3.3"
  }
}
